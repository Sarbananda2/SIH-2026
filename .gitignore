# ---- Dependencies ----
node_modules/
.pnp
.pnp.js

# ---- Build output ----
dist/
dist-ssr/
build/
*.local

# ---- Environment & secrets ----
# Never commit real credentials. Commit .env.example with placeholder values.
.env
.env.*
!.env.example
*.pem
*.key
secrets.json
credentials.json
serviceAccount*.json

# ---- Logs ----
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---- Caches ----
.vite/
.cache/
.eslintcache
.npm/
*.tsbuildinfo

# ---- Editors ----
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.swp
*.swo
*~

# ---- OS ----
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
desktop.ini

# ---- Media & datasets ----
# Video, model weights, and datasets do not belong in git. Store them
# externally and record where in docs/references/.
*.mp4
*.avi
*.mov
*.mkv
*.weights
*.pt
*.onnx
*.h5
datasets/
